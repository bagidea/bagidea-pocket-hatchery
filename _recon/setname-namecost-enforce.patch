# Patch: Enforce name_cost in setname
# ==============================================================================
# File:   contract/pockethatch/pockethatch.cpp
# Action: setname() — line 890-916
# Status: UN-APPLIED — awaiting CEO approval before setcode
# Date:   2026-07-19
#
# WHAT:  Add HATCH token burn to enforce `cfg.name_cost` in setname action.
#        Currently setname charges ZERO HATCH despite config saying 1.0000 HATCH.
#
# WHY:   CEO audit revealed name_cost is a ghost field — config says 1 HATCH but
#        setname ignores it entirely. Fix uses burn_hatch() helper which:
#          1. Transfers cfg.name_cost from player → contract (inline transfer)
#          2. Funds the reward pool with the burnt tokens
#          3. Tracks burn stats on player row
#        This is the SAME pattern used by accelerate() at line 877.
#
# GUARD: The burn_hatch() pattern sends from=player → to=get_self() (contract),
#        so fee_account ≠ get_self() guard is NOT triggered — the transfer is
#        always player→contract, never contract→fee_account. This avoids the
#        "cannot transfer to self" bug that hit on_wax_transfer (where the wake
#        forward was contract→fee_account and fee_account==get_self()).
#
#        If CEO prefers to ALSO forward to fee_account when fee_account≠self:
#        see OPTION B in comments below the patch.
#
# RISK:  Minimal — single-action change, no table migration, no ABI change.
#        Existing rename-NFT logic untouched. Only adds cost enforcement.
# ==============================================================================

--- a/contract/pockethatch/pockethatch.cpp
+++ b/contract/pockethatch/pockethatch.cpp
@@ -896,8 +896,17 @@ void pockethatch::setname(name owner, uint64_t asset_id, const std::string& new_
     check(c_it->owner == owner, "not your creature");

     config_row cfg = _cfg();

+    // 🔥 Deduct name_cost HATCH from player (v3 patch — was ghost field)
+    if (cfg.name_cost.amount > 0) {
+        // burn_hatch sends player→contract→reward_pool.
+        // Safe: from=owner≠get_self() — no "cannot transfer to self" risk.
+        burn_hatch(owner, cfg.name_cost, "setname:" + std::to_string(asset_id));
+    }
+
     // Mirror to NFT (NFT required — reject if not found)
     check(nft_exists(cfg.collection, owner, asset_id), "setname requires the NFT to be held by player");
     {
         ATTR_MAP new_mut = {
             {"stage",  ATOM_ATTR((uint32_t)c_it->stage)},
             {"growth", ATOM_ATTR(c_it->growth_base + c_it->fed_growth)},
             {"name",   ATOM_ATTR(new_name)}


