{
  "$meta": {
    "name": "Pocket Hatchery — Design Tokens",
    "version": "0.1.0",
    "author": "Monanisa (Designer)",
    "derivedFrom": "ART.md v0.1 (North Star: Cozy-premium creature collector)",
    "platform": "web (WAX Cloud Wallet players)",
    "baseFontPx": 16,
    "spacingGridPx": 4,
    "note": "Token names map 1:1 to CSS custom properties in tokens.css (color.brand.cream -> --ph-color-cream). Hex values are the single source of truth and trace back to ART.md §3."
  },
  "color": {
    "brand": {
      "cream": {
        "value": "#FAFAFA",
        "use": "base canvas / UI background / studio bg"
      },
      "sky": {
        "value": "#38BDF8",
        "use": "sky, cool panels"
      },
      "mint": {
        "value": "#34D399",
        "use": "grass, common tier, secondary accent"
      },
      "meadow": {
        "value": "#22C55E",
        "use": "grass shadow, success, contrast green"
      },
      "golden": {
        "value": "#F59E0B",
        "use": "primary CTA, glowing egg, warm light"
      },
      "goldenLight": {
        "value": "#FDE68A",
        "use": "lighter golden for gradients / hero egg highlights"
      },
      "golden65": {
        "value": "rgba(245,158,11,0.65)",
        "use": "golden glow alpha, e.g. egg icon drop-shadow"
      },
      "coral": {
        "value": "#F43F5E",
        "use": "cute accent, hearts, love / danger-soft"
      },
      "lavender": {
        "value": "#A78BFA",
        "use": "magic, aura, epic family"
      },
      "earth": {
        "value": "#F97316",
        "use": "soil, paths, wood"
      },
      "ink": {
        "value": "#1E1B4B",
        "use": "primary text (never pure black)"
      }
    },
    "surface": {
      "canvas": {
        "value": "#FAFAFA",
        "use": "app background"
      },
      "raised": {
        "value": "#FFFFFF",
        "use": "cards / panels on canvas"
      },
      "sunken": {
        "value": "#F0E8D8",
        "use": "input wells, track backgrounds"
      },
      "overlayScrim": {
        "value": "rgba(30,27,75,0.45)",
        "use": "behind modal / bottom-sheet"
      }
    },
    "text": {
      "primary": {
        "value": "#1E1B4B",
        "use": "headings + body"
      },
      "muted": {
        "value": "#94A3B8",
        "use": "captions, secondary labels"
      },
      "onGolden": {
        "value": "#1E1B4B",
        "use": "label on golden primary button (NOT white — contrast ~7.9:1)"
      },
      "onDark": {
        "value": "#FAFAFA",
        "use": "label on dark/scrim surfaces"
      },
      "disabled": {
        "value": "#B7B3C2",
        "use": "disabled text"
      }
    },
    "border": {
      "soft": {
        "value": "#E8D5B8",
        "use": "hairline separators on cream (no hard black lines)"
      },
      "focus": {
        "value": "#3B82F6",
        "use": "keyboard focus ring (matches rare-blue)"
      }
    },
    "state": {
      "success": {
        "value": "#22C55E",
        "use": "confirmed tx / harvest done"
      },
      "warning": {
        "value": "#FB923C",
        "use": "low energy / caution"
      },
      "danger": {
        "value": "#F43F5E",
        "use": "failed tx / destructive"
      },
      "info": {
        "value": "#3B82F6",
        "use": "neutral notice"
      }
    },
    "rarity": {
      "common": {
        "value": "#22C55E",
        "aura": "rgba(34,197,94,0.45)",
        "label": "Common"
      },
      "rare": {
        "value": "#3B82F6",
        "aura": "rgba(59,130,246,0.50)",
        "label": "Rare"
      },
      "epic": {
        "value": "#8B5CF6",
        "aura": "rgba(139,92,246,0.55)",
        "label": "Epic"
      },
      "legendary": {
        "value": "#F59E0B",
        "aura": "rgba(245,158,11,0.60)",
        "label": "Legendary",
        "iridescent": true
      }
    }
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radius": {
    "sm": "12px",
    "md": "16px",
    "lg": "20px",
    "xl": "24px",
    "2xl": "28px",
    "pill": "999px"
  },
  "typography": {
    "fontFamily": {
      "display": "\"Baloo 2\", \"Fredoka\", \"M PLUS Rounded 1c\", system-ui, sans-serif",
      "body": "\"Nunito\", \"Mali\", system-ui, sans-serif",
      "numeric": "\"Nunito\", \"M PLUS Rounded 1c\", ui-monospace, system-ui",
      "thai": "\"Mali\", \"Fahkwang\", \"Nunito\", sans-serif"
    },
    "weight": {
      "regular": 600,
      "bold": 700,
      "heavy": 800
    },
    "scale": {
      "display": {
        "size": "40px",
        "lineHeight": "48px",
        "weight": 800,
        "family": "display"
      },
      "h1": {
        "size": "32px",
        "lineHeight": "40px",
        "weight": 800,
        "family": "display"
      },
      "h2": {
        "size": "24px",
        "lineHeight": "32px",
        "weight": 700,
        "family": "display"
      },
      "h3": {
        "size": "20px",
        "lineHeight": "28px",
        "weight": 700,
        "family": "body"
      },
      "body": {
        "size": "16px",
        "lineHeight": "24px",
        "weight": 600,
        "family": "body"
      },
      "label": {
        "size": "15px",
        "lineHeight": "20px",
        "weight": 700,
        "family": "body"
      },
      "caption": {
        "size": "13px",
        "lineHeight": "18px",
        "weight": 600,
        "family": "body"
      },
      "numeric": {
        "size": "16px",
        "lineHeight": "20px",
        "weight": 800,
        "family": "numeric",
        "featureSettings": "tabular-nums"
      }
    }
  },
  "elevation": {
    "0": {
      "shadow": "none",
      "use": "flat / inline"
    },
    "1": {
      "shadow": "0 2px 6px rgba(249,115,22,0.18)",
      "use": "resource bar, chips"
    },
    "2": {
      "shadow": "0 8px 20px rgba(249,115,22,0.22)",
      "use": "cards, buttons resting"
    },
    "3": {
      "shadow": "0 14px 32px rgba(30,27,75,0.18)",
      "use": "modal / bottom-sheet"
    },
    "glowGolden": {
      "shadow": "0 0 24px rgba(245,158,11,0.65)",
      "use": "glowing egg, primary CTA hover"
    },
    "glowLegendary": {
      "shadow": "0 0 28px rgba(245,158,11,0.70)",
      "use": "legendary card aura"
    }
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "140ms",
      "base": "220ms",
      "slow": "360ms",
      "evolve": "900ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "decelerate": "cubic-bezier(0.0, 0.0, 0.2, 1)",
      "pop": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "spring": "cubic-bezier(0.22, 1.2, 0.36, 1)"
    },
    "preset": {
      "buttonPress": {
        "keyframes": "scale 1 -> 0.96 -> 1.04 -> 1",
        "duration": "220ms",
        "easing": "pop",
        "note": "the office 'juice' rule from ART.md §7"
      },
      "toastIn": {
        "from": "translateY(-12px) opacity 0",
        "to": "translateY(0) opacity 1",
        "duration": "220ms",
        "easing": "decelerate"
      },
      "sheetIn": {
        "from": "translateY(100%)",
        "to": "translateY(0)",
        "duration": "360ms",
        "easing": "spring"
      }
    }
  },
  "component": {
    "button": {
      "minHeight": "44px",
      "paddingX": "24px",
      "radius": "pill",
      "labelStyle": "label"
    },
    "card": {
      "radius": "xl",
      "padding": "16px",
      "frameWidth": "4px",
      "elevation": "2"
    },
    "modal": {
      "radius": "2xl",
      "maxWidth": "420px",
      "padding": "24px",
      "elevation": "3"
    },
    "bottomSheet": {
      "radiusTop": "2xl",
      "padding": "24px",
      "elevation": "3",
      "grabber": true
    },
    "toast": {
      "radius": "pill",
      "paddingX": "16px",
      "minHeight": "40px",
      "elevation": "2"
    },
    "progress": {
      "trackHeight": "14px",
      "radius": "pill",
      "fill": "golden",
      "track": "sunken"
    },
    "resourceBar": {
      "radius": "pill",
      "height": "40px",
      "gap": "12px",
      "elevation": "1"
    },
    "scrollbar": {
      "width": "8px",
      "thumb": "rgba(59,130,246,0.55)",
      "thumbHover": "rgba(59,130,246,0.8)",
      "track": "transparent",
      "radius": "pill",
      "note": "office signature slim blue-glass scrollbar — see tokens.css"
    }
  }
}